# WealthMind4x Environment Configuration
# Never commit real secrets. Populate these on your server / CI.

# Backend API base URL (your own proxy/server that brokers the actual data)
VITE_API_BASE_URL=

# Market data provider selection: mt5 | tradingview | crypto | none
VITE_MARKET_PROVIDER=none

# Public identifiers (safe for frontend)
VITE_MT5_PUBLIC_ENDPOINT=
VITE_TRADINGVIEW_PUBLIC_ENDPOINT=
VITE_CRYPTO_PUBLIC_ENDPOINT=

# Auth is handled server-side. Never put broker/exchange secrets here.